          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"gitlab/gitlab-webservice\"}[$__rate_interval])) / sum(rate(http_request_duration_seconds_count{job=\"gitlab/gitlab-webservice\"}[$__rate_interval]))",

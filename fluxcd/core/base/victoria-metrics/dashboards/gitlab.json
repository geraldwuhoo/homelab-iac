          "expr": "sum(rate(gitlab_rails_queue_duration_seconds_sum[$__rate_interval])) / sum(rate(gitlab_rails_queue_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "queued before rails",
          "refId": "B"
        }

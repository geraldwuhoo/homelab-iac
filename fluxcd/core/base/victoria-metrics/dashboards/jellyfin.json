        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(up{job=\"media/jellyfin\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },

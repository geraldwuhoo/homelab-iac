{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 10,
  "flux": {
    "fileMatch": ["fluxcd/.+\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["fluxcd/.+\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["fluxcd/.+\\.yaml$"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["docker.io/kopia/kopia"],
      "allowedVersions": "/^\\d{1,3}\\.\\d+\\.\\d+$/"
    }
  ]
}
